# ==========================================================================
# CodeHub — пример переменных окружения.
# Скопируйте файл в .env и заполните значения: cp .env.example .env
# ==========================================================================

# --- Основное -------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=codehub.example.com,www.codehub.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://codehub.example.com,https://www.codehub.example.com
DJANGO_TIME_ZONE=Europe/Moscow

# --- База данных (PostgreSQL) --------------------------------------------
# Вариант 1: одна строка подключения.
DATABASE_URL=postgres://codehub:strong-password@127.0.0.1:5432/codehub
# Вариант 2: отдельные переменные (используются, если DATABASE_URL пуст).
# POSTGRES_DB=codehub
# POSTGRES_USER=codehub
# POSTGRES_PASSWORD=strong-password
# POSTGRES_HOST=127.0.0.1
# POSTGRES_PORT=5432

# --- Почта (уведомления о новых работах и проверках) ---------------------
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=no-reply@codehub.example.com
EMAIL_HOST_PASSWORD=smtp-password
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=CodeHub <no-reply@codehub.example.com>
TEACHER_NOTIFICATION_EMAIL=teacher@codehub.example.com

# --- Публичные контакты и брендинг лендинга ------------------------------
CODEHUB_NAME=CodeHub
CODEHUB_TAGLINE=Онлайн-курс по программированию: от нуля до первого оффера
CODEHUB_PRICE=$100
CODEHUB_PHONE=+7 (900) 000-00-00
CODEHUB_PHONE_2=+7 (900) 111-11-11
CODEHUB_EMAIL=hello@codehub.dev
CODEHUB_TELEGRAM=https://t.me/codehub
CODEHUB_WHATSAPP=https://wa.me/79000000000
CODEHUB_INSTAGRAM=https://instagram.com/codehub
CODEHUB_YOUTUBE=https://youtube.com/@codehub
CODEHUB_GITHUB=https://github.com/codehub

# --- Файлы и безопасность ------------------------------------------------
# Максимальный размер загружаемого ДЗ в байтах (по умолчанию 1 ГБ).
HOMEWORK_MAX_UPLOAD_SIZE=1073741824
# Файлы больше этого размера стримятся во временный файл, а не держатся в памяти.
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
# Лимит на необработанные поля формы (без файлов).
DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
# Использовать hashed-манифест статики (по умолчанию — да в проде,
# нет в DEBUG и в тестах).
DJANGO_USE_MANIFEST_STATIC=true
# HSTS: 31536000 (1 год). Установите 0, если сайт ещё не на HTTPS.
DJANGO_HSTS_SECONDS=31536000
# Редирект на HTTPS (true, если TLS терминируется на reverse-proxy).
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_COOKIES=true
